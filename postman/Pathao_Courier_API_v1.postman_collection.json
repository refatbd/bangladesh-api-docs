  "item": [
    {
      "name": "Authentication (OAuth 2.0)",
      "item": [
        {
          "name": "Issue Token (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", json.access_token);",
                  "    console.log(\"Saved access_token:\", json.access_token);",
                  "}",
                  "if (json.refresh_token) {",
                  "    pm.collectionVariables.set(\"refresh_token\", json.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"client_id\": \"{{client_id}}\",\n    \"client_secret\": \"{{client_secret}}\",\n    \"grant_type\": \"password\",\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/aladdin/api/v1/issue-token",
              "host": ["{{base_url}}"],
              "path": ["aladdin", "api", "v1", "issue-token"]
            }
          }
        },
        {
          "name": "Issue Token (Refresh Token Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
