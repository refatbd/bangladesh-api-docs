    {
      "name": "Billing & Calculations",
      "item": [
        {
          "name": "Calculate Parcel Charge",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "API-ACCESS-TOKEN",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/charge/charge_calculator?delivery_area_id=12&pickup_area_id=1&cash_collection_amount=1500&weight=750",
              "host": ["{{base_url}}"],
              "path": ["charge", "charge_calculator"],
              "query": [
                {
                  "key": "delivery_area_id",
                  "value": "12"
                },
                {
                  "key": "pickup_area_id",
                  "value": "1"
                },
                {
                  "key": "cash_collection_amount",
                  "value": "1500"
                },
                {
                  "key": "weight",
