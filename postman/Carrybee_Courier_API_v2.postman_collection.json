              "raw": "{\n  \"name\": \"Banani Central Hub\",\n  \"contact_name\": \"Refat Rahman\",\n  \"contact_number\": \"01811223344\",\n  \"address\": \"House 18, Road 11, Block D, Banani, Dhaka\",\n  \"city_id\": 1,\n  \"zone_id\": 8\n}"
