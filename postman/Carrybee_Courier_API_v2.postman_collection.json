{
  "info": {
    "_postman_id": "cbee-v2-refatbd-991823",
    "name": "Carrybee Courier API v2.0",
    "description": "Comprehensive Postman Collection for Carrybee Delivery API v2.0.\nMaintained by Refat Rahman (https://refat.ovh | @refatbd).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://sandbox.carrybee.com",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "YOUR_CLIENT_ID",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "YOUR_CLIENT_SECRET",
      "type": "string"
    },
    {
      "key": "client_context",
      "value": "YOUR_CLIENT_CONTEXT",
      "type": "string"
    },
    {
      "key": "consignment_id",
      "value": "CB-982341",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "cb_wh_sec_sample_secret_token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Location & Coverage",
      "item": [
        {
          "name": "Get All Cities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/cities",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "cities"]
            }
          }
        },
        {
          "name": "Get Zones by City ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/zones/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "zones", "1"]
            }
          }
        },
        {
          "name": "Area Autocomplete Suggestion",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/area-suggestion?search=Dhanmondi",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "area-suggestion"],
              "query": [
                { "key": "search", "value": "Dhanmondi" }
              ]
            }
          }
        },
        {
          "name": "Resolve Address Details",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"House 12, Road 4, Sector 7, Uttara, Dhaka\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/address-details",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "address-details"]
            }
          }
        }
      ]
    },
    {
