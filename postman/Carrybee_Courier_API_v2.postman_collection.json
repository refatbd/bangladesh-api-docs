    {
      "name": "3. Orders & Booking",
      "item": [
        {
          "name": "Create Single Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": 101,\n  \"merchant_order_id\": \"INV-2026-CB-001\",\n  \"recipient_name\": \"Tanvir Ahmed\",\n  \"recipient_phone\": \"01811223344\",\n  \"recipient_address\": \"House 12, Road 4, Sector 7, Uttara, Dhaka\",\n  \"recipient_city\": 1,\n  \"recipient_zone\": 5,\n  \"delivery_type\": 1,\n  \"product_type\": 1,\n  \"item_weight\": 1200,\n  \"item_description\": \"Smart Casual Denim Shirt - Size L\",\n  \"item_quantity\": 1,\n  \"collectable_amount\": 1850,\n  \"special_instruction\": \"Call recipient before dispatching\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "orders"]
            }
          }
        },
        {
          "name": "Create Bulk Orders (Async 202)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"store_id\": 101,\n      \"merchant_order_id\": \"BULK-001\",\n      \"recipient_name\": \"Customer A\",\n      \"recipient_phone\": \"01811223344\",\n      \"recipient_address\": \"Gulshan 1, Dhaka\",\n      \"recipient_city\": 1,\n      \"recipient_zone\": 4,\n      \"delivery_type\": 1,\n      \"product_type\": 1,\n      \"item_weight\": 500,\n      \"item_description\": \"Item 1\",\n      \"item_quantity\": 1,\n      \"collectable_amount\": 500\n    },\n    {\n      \"store_id\": 101,\n      \"merchant_order_id\": \"BULK-002\",\n      \"recipient_name\": \"Customer B\",\n      \"recipient_phone\": \"01700112233\",\n      \"recipient_address\": \"Agrabad, Chattogram\",\n      \"recipient_city\": 2,\n      \"recipient_zone\": 12,\n      \"delivery_type\": 1,\n      \"product_type\": 1,\n      \"item_weight\": 1000,\n      \"item_description\": \"Item 2\",\n      \"item_quantity\": 1,\n      \"collectable_amount\": 1200\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/orders-bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "orders-bulk"]
            }
          }
        },
        {
          "name": "Track Order by Consignment ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/orders/track/{{consignment_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "orders", "track", "{{consignment_id}}"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Client-ID", "value": "{{client_id}}" },
              { "key": "Client-Secret", "value": "{{client_secret}}" },
              { "key": "Client-Context", "value": "{{client_context}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consignment_id\": \"{{consignment_id}}\",\n  \"reason\": \"Customer requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/orders/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "orders", "cancel"]
            }
          }
        }
      ]
    },
