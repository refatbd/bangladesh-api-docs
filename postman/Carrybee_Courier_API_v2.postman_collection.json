    {
      "name": "5. Webhooks & Handshake",
      "item": [
        {
          "name": "Simulate Webhook Handshake Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-CB-Webhook-Integration-Header", "value": "{{webhook_secret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"handshake\",\n  \"message\": \"Carrybee webhook verification handshake\",\n  \"timestamp\": \"2026-10-27T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/carrybee/webhook",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "carrybee", "webhook"]
            }
          }
        },
        {
          "name": "Simulate Order Delivered Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-CB-Webhook-Integration-Header", "value": "{{webhook_secret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order.delivered\",\n  \"consignment_id\": \"{{consignment_id}}\",\n  \"merchant_order_id\": \"INV-2026-9901\",\n  \"order_status\": \"delivered\",\n  \"collected_amount\": 1850.00,\n  \"delivery_fee\": 70.00,\n  \"cod_fee\": 18.50,\n  \"rider\": {\n    \"name\": \"Kamrul Hassan\",\n    \"phone\": \"01700998877\"\n  },\n  \"recipient\": {\n    \"name\": \"Tanvir Ahmed\",\n    \"phone\": \"01811223344\",\n    \"address\": \"House 12, Road 4, Sector 7, Uttara, Dhaka\"\n  },\n  \"timestamp\": \"2026-10-27T11:45:00+06:00\",\n  \"remarks\": \"Delivered successfully with OTP verification\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/carrybee/webhook",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "carrybee", "webhook"]
            }
          }
